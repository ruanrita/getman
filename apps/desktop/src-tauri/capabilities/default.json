{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, outgoing HTTP to any host (it is an API client), folder picker and confirm/alert dialogs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "dialog:allow-ask"
  ]
}
