# PostgreSQL connection string
DATABASE_URL=postgres://getman:getman@localhost:55432/getman
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts 2FA secrets at rest. Losing it means users must set up 2FA again.
GETMAN_ENCRYPTION_KEY=
PORT=8787
HOST=0.0.0.0
# Comma-separated browser origins allowed by CORS (the desktop app does not need CORS).
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost
# Session lifetime in days (sliding)
SESSION_TTL_DAYS=30
# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik)
TRUST_PROXY=false
# Folder for "local folder" backup targets. Unset = that target type is disabled.
GETMAN_BACKUP_DIR=
# Allow backup targets / AI base URLs on private networks (LAN MinIO, internal DB, Ollama).
# Off by default: any user can create a workspace and configure these (SSRF protection).
GETMAN_ALLOW_PRIVATE_NETWORKS=false
