{
  "name": "getman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Getman - open source API client (self-hosted, Git-friendly, AI-documented)",
  "license": "MIT",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "pnpm --filter @getman/desktop dev",
    "build": "pnpm --filter @getman/desktop build",
    "tauri": "pnpm --filter @getman/desktop tauri",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "server": "pnpm --filter @getman/server dev",
    "test:server": "pnpm --filter @getman/server test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@types/node": "^26.6.5"
  }
}
